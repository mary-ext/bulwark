# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Node / web
node_modules/
.vite/
# The built UI bundle is generated, not committed. `server/build.rs` rebuilds it
# during `cargo build` when pnpm + web/node_modules are present; otherwise a
# placeholder is embedded. The folder itself is kept (.gitkeep) so the
# rust-embed `#[folder]` always compiles.
web/dist/*
!web/dist/.gitkeep

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Bulwark runtime data
/data/
*.log
config.local.yaml
